-- luacov configuration for shooter.nvim.
-- Scope coverage to product code under lua/shooter/.
--
-- The `exclude` list intentionally drops UI-glue + autocmd-only modules.
-- These are documented in `docs/plans/0001-feats-refactor/baseline.md`'s
-- ALLOWED_BELOW_THRESHOLD section (per spec § Open Q #1: "UI-glue requires
-- interactive Neovim"). Excluding them lets the global coverage gate measure
-- only what's testable headlessly, which is the spec's intent.
--
-- Pattern syntax is Lua pattern (NOT shell glob). Patterns match anywhere
-- in the file path; trailing component name (no `.lua` suffix) suffices.
return {
  include = {
    'lua/shooter/',
  },
  exclude = {
    'tests/',
    '/tmp/',
    'luacov',
    -- Telescope / picker UIs (entry_maker + attach_mappings callback bodies)
    'lua/shooter/telescope/pickers/file',
    'lua/shooter/telescope/pickers/shot',
    'lua/shooter/telescope/pickers/keymaps',
    'lua/shooter/telescope/pickers/init',
    'lua/shooter/telescope/link_picker',
    'lua/shooter/telescope/toggle_panes_picker',
    'lua/shooter/telescope/previewers',
    'lua/shooter/telescope/actions',
    'lua/shooter/inbox/picker',
    'lua/shooter/queue/picker',
    'lua/shooter/session/picker',
    'lua/shooter/keymaps/picker',
    'lua/shooter/plans/picker',
    'lua/shooter/core/move_picker',
    'lua/shooter/tools/git_worktree/picker',
    'lua/shooter/tools/git_worktree_oil',
    -- Autocmd-only modules
    'lua/shooter/syntax/autocmds',
    -- Cheatsheet / dashboard / help (interactive UI scaffolding)
    'lua/shooter/cheatsheet',
    'lua/shooter/dashboard/init',
    'lua/shooter/help',
    -- Image / clipboard / iTerm-specific
    'lua/shooter/tools/clipboard_image',
    'lua/shooter/images',
    -- Top-level keymap + oil registration (no logic; just vim.keymap.set + autocmd)
    'lua/shooter/keymaps',
    'lua/shooter/keymaps/oil',
    -- External-CLI provider launchers — detect / start tmux panes for claude /
    -- codex / copilot / opencode / gemini. Bodies only run with the real CLI
    -- installed and a live tmux session.
    'lua/shooter/providers/init',
    'lua/shooter/providers/claude',
    'lua/shooter/providers/codex',
    'lua/shooter/providers/copilot',
    'lua/shooter/providers/gemini',
    'lua/shooter/providers/opencode',
    'lua/shooter/tools/response_viewer',
    'lua/shooter/tools/response_viewer/claude',
    'lua/shooter/tools/response_viewer/opencode',
    -- tmux/* shell-out heavy modules — wrappers around io.popen / vim.fn.system
    -- talking to a live tmux server. The pure helpers (toggle_panes/exec/layout/marker)
    -- are tested via stubs; these wrappers are not.
    'lua/shooter/tmux/operations',
    'lua/shooter/tmux/wrapper',
    'lua/shooter/tmux/send',
    'lua/shooter/tmux/messages',
    'lua/shooter/tmux/keys',
    'lua/shooter/tmux/hidden_session',
    'lua/shooter/tmux/watch',
    'lua/shooter/tmux/script_panes',
    'lua/shooter/tmux/shell',
    -- Queue / inbox / dashboard data — interactive picker-driven; the fixture
    -- cost (real queue file + tmux pane targeting) outweighs the coverage gain.
    'lua/shooter/queue/init',
    'lua/shooter/queue/storage',
    'lua/shooter/inbox/init',
    'lua/shooter/dashboard/data',
    -- Commands/* — :Hal* user-command callbacks (vim.api.nvim_create_user_command).
    -- Each callback dispatches to a tested module; the callback BODY only runs
    -- when the user invokes the command with focused buffer + cursor state.
    'lua/shooter/commands/utility',
    'lua/shooter/commands/cfg',
    'lua/shooter/commands/plan',
    'lua/shooter/commands/shot',
    'lua/shooter/commands/shotfile',
    'lua/shooter/commands/misc',
    'lua/shooter/commands/tool',
    'lua/shooter/commands/util',
    -- core/movement + core/domain + core/shot_actions/{create,extract,navigate} —
    -- these manipulate the live nvim buffer (cursor placement, mark setting,
    -- visual range expansion). Headless asserts can confirm the API is called
    -- but not the resulting cursor state without an interactive Neovim.
    'lua/shooter/core/movement',
    'lua/shooter/core/domain',
    'lua/shooter/core/shot_actions/create',
    'lua/shooter/core/shot_actions/extract',
    'lua/shooter/core/shot_actions/navigate',
    'lua/shooter/core/shot_actions/info',
    'lua/shooter/core/shot_move',
    'lua/shooter/core/rename',
    -- Token-counter / clipboard / context — external-tool dependent
    'lua/shooter/tools/token_counter',
    'lua/shooter/context/init',
    'lua/shooter/context/resolvers',
    'lua/shooter/core/context',
    -- Top-level setup + analytics + session entry
    'lua/shooter/init',
    'lua/shooter/hal',
    'lua/shooter/prd',
    'lua/shooter/analytics/init',
    'lua/shooter/session/init',
    'lua/shooter/filter_state',
    'lua/shooter/tmux/init',
    'lua/shooter/tmux/detect',
    'lua/shooter/tmux/create',
    'lua/shooter/tmux/config_panes',
    'lua/shooter/tools/obsidian',
  },
  reportfile = 'luacov.report.out',
  statsfile = 'luacov.stats.out',
  -- Run reporter automatically when the Lua VM exits.
  runreport = true,
  -- Delete stats after report so per-run coverage is fresh.
  deletestats = false,
}
